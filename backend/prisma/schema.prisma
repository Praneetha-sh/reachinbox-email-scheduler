generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum EmailStatus {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
  CANCELLED
}

enum EventType {
  SCHEDULED
  QUEUED
  PROCESSING
  SENT
  FAILED
  RATE_LIMITED
  RETRY
  CANCELLED
}

model User {
  id        String   @id @default(uuid())
  googleId  String   @unique
  email     String   @unique
  name      String
  avatarUrl String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  senders         Sender[]
  campaigns       EmailCampaign[]
  slackConnection SlackConnection?
}

model Sender {
  id       String @id @default(uuid())
  userId   String
  email    String
  name     String?

  smtpHost              String
  smtpPort              Int
  smtpUsername          String
  smtpPasswordEncrypted String @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns EmailCampaign[]
  emails    Email[]

  @@unique([userId, email])
  @@index([userId])
}

model EmailCampaign {
  id       String @id @default(uuid())
  userId   String
  senderId String

  name        String?
  subject     String @db.Text
  body        String @db.LongText

  startTime      DateTime
  delayBetweenMs Int
  hourlyLimit    Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender Sender @relation(fields: [senderId], references: [id], onDelete: Restrict)
  emails Email[]

  @@index([userId])
  @@index([senderId])
  @@index([startTime])
}

model Email {
  id         String @id @default(uuid())
  campaignId String
  senderId   String

  recipientName  String?
  recipientEmail String

  subject String @db.Text
  body    String @db.LongText

    scheduledAt        DateTime
  sentAt             DateTime?
  processingStartedAt DateTime?

  status EmailStatus @default(SCHEDULED)

  bullmqJobId String? @unique
  idempotencyKey String @unique

  attempts    Int       @default(0)
  lastError   String?   @db.Text
  nextRetryAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaign EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sender   Sender        @relation(fields: [senderId], references: [id], onDelete: Restrict)
  events   EmailEvent[]

  @@index([campaignId])
  @@index([senderId])
  @@index([status])
  @@index([scheduledAt])
  @@index([recipientEmail])
}

model EmailEvent {
  id      String @id @default(uuid())
  emailId String

  type      EventType
  message   String? @db.Text
  createdAt DateTime @default(now())

  email Email @relation(fields: [emailId], references: [id], onDelete: Cascade)

  @@index([emailId])
  @@index([type])
  @@index([createdAt])
}

model SlackConnection {
  id     String @id @default(uuid())
  userId String @unique

  slackUserId String?
  teamId      String?
  teamName    String?

  accessTokenEncrypted String @db.Text
  webhookUrl           String @db.Text

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}